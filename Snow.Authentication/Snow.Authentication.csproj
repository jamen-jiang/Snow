<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Authentication</RootNamespace>
    <AssemblyName>Snow.Authentication</AssemblyName>
    <PackageId>Snow.Authentication</PackageId>
    <Description>认证: 一个模块四项配置, HS256 签发令牌, 验签交给框架的 JwtBearer, 另加会话白名单、踢人封禁、注解鉴权</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.AspNetCore\Snow.AspNetCore.csproj" />
    <ProjectReference Include="..\Snow.Authorization\Snow.Authorization.csproj" />
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.Security\Snow.Security.csproj" />
    <ProjectReference Include="..\Snow.Timing\Snow.Timing.csproj" />
  </ItemGroup>

</Project>