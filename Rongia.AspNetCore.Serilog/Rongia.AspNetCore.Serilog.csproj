<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rongia.AspNetCore.Serilog</AssemblyName>
    <PackageId>Rongia.AspNetCore.Serilog</PackageId>
    <RootNamespace>Rongia.AspNetCore.Serilog</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <Description>日志: Serilog 集成(宿主一行接入 + 当前用户/租户/会话等字段自动写入日志上下文)</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rongia.Core\Rongia.Core.csproj" />
    <ProjectReference Include="..\Rongia.Security\Rongia.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
  </ItemGroup>

</Project>
