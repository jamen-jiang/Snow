<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\common.props" />


  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rongia.Expressions</RootNamespace>
    <Description>表达式引擎: 基于 DynamicExpresso, 表达式按 C# 语法书写(变量名即参数名, 另有 root / p0 / a0 / result 约定变量), 支持运算 / 属性方法访问 / 三目 / Lambda / typeof</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.6" />
  </ItemGroup>

</Project>
