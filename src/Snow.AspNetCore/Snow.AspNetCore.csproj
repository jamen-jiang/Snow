<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snow.AspNetCore</AssemblyName>
    <PackageId>Snow.AspNetCore</PackageId>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- 能力包只含模块与扩展方法, 不含静态资源; 关掉 StaticWebAssets 以免 SDK 报 scoped css bundle 缺端点 -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Description>Web 宿主模块包: 接线层(SnowAspNetCoreModule 提供 HTTP 上下文访问器 / 宿主环境名 / Web 对象访问器 / 包内静态资源合并) + 接线所需的 5 个基础模块(安全 / 授权 / 工作单元 / 校验 / 链路标识)。整条 HTTP 管道与端点映射由宿主在启动模块里按行序手写: 本包只提供 UseSnowXxx() 与 UseSnowEndpoints() 这些扩展方法, 不铺骨架、不代挂中间件。其余能力一律由宿主自行引用: 应用层、认证、缓存、分布式锁、后台作业、事件总线、消息、邮件、FTP、HTTP 客户端、Excel、工作流、EntityFrameworkCore 及其第三方实现</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow\Snow.csproj" />
    <ProjectReference Include="..\Snow.Authorization\Snow.Authorization.csproj" />
    <ProjectReference Include="..\Snow.ExceptionHandling\Snow.ExceptionHandling.csproj" />
    <ProjectReference Include="..\Snow.Security\Snow.Security.csproj" />
    <ProjectReference Include="..\Snow.Tracing\Snow.Tracing.csproj" />
    <ProjectReference Include="..\Snow.Uow\Snow.Uow.csproj" />
    <ProjectReference Include="..\Snow.Validation\Snow.Validation.csproj" />
  </ItemGroup>

</Project>