<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>MVC 与自动 API: 应用服务按约定自动暴露成 Controller(对应 ABP 的 Volo.Abp.AspNetCore.Mvc), 统一结果包装与异常响应, 免手写 Controller</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.AspNetCore\Snow.AspNetCore.csproj" />
    <ProjectReference Include="..\Snow.Validation\Snow.Validation.csproj" />
  </ItemGroup>

</Project>
