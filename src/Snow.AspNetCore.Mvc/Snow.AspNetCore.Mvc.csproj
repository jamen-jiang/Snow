<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Snow.AspNetCore.Mvc</AssemblyName>
	<PackageId>Snow.AspNetCore.Mvc</PackageId>
	<OutputType>Library</OutputType>
	<IsPackable>true</IsPackable>
	<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	<!-- 能力包只含模块与扩展方法, 不含静态资源; 关掉 StaticWebAssets 以免 SDK 报 scoped css bundle 缺端点 -->
	<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Description>MVC 与自动 API: 应用服务按约定自动暴露成 Controller(对应 ABP 的 Volo.Abp.AspNetCore.Mvc), 统一结果包装与异常响应, 免手写 Controller</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.AspNetCore\Snow.AspNetCore.csproj" />
    <ProjectReference Include="..\Snow.Json\Snow.Json.csproj" />
    <ProjectReference Include="..\Snow.Validation\Snow.Validation.csproj" />
  </ItemGroup>

</Project>
