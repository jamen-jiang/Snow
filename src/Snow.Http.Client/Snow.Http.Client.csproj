<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Http.Client</RootNamespace>
    <Description>HTTP 客户端: 基于 IHttpClientFactory 的命名客户端管线, 默认客户端可配基础地址/超时/请求头(与 ABP 的 Volo.Abp.Http.Client 同位)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
  </ItemGroup>

</Project>
