<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Validation.FluentValidation</RootNamespace>
    <Description>FluentValidation 集成: 扫描 AbstractValidator 实现, 与本框架的 ISnowObjectValidator 合成一条校验管线(对位 ABP 的 Volo.Abp.FluentValidation)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.Validation\Snow.Validation.csproj" />
  </ItemGroup>

</Project>
