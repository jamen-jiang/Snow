<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Snow.AspNetCore.Authentication</AssemblyName>
	<PackageId>Snow.AspNetCore.Authentication</PackageId>
	<OutputType>Library</OutputType>
	<IsPackable>true</IsPackable>
	<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	<!-- 能力包只含模块与扩展方法, 不含静态资源; 关掉 StaticWebAssets 以免 SDK 报 scoped css bundle 缺端点 -->
	<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Description>认证: 一个模块四项配置, HS256 签发令牌, 验签交给框架的 JwtBearer, 另加会话白名单、踢人封禁</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Authorization\Snow.Authorization.csproj" />
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.Security\Snow.Security.csproj" />
    <ProjectReference Include="..\Snow.Timing\Snow.Timing.csproj" />
  </ItemGroup>

</Project>
