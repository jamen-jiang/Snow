<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snow.BackgroundJobs</AssemblyName>
    <PackageId>Snow.BackgroundJobs</PackageId>
    <RootNamespace>Snow.BackgroundJobs</RootNamespace>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <Description>后台任务: lambda 入队契约、任务记录与选项、进程内存储、轮询 worker 与模块注册</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.DistributedLocking\Snow.DistributedLocking.csproj" />
    <ProjectReference Include="..\Snow.Timing\Snow.Timing.csproj" />
  </ItemGroup>

</Project>
