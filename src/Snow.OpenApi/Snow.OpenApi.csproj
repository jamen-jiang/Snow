<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>OpenAPI 文档: 用官方 Microsoft.AspNetCore.OpenApi 生成文档, Scalar 提供调试界面(对应 ABP 的 Volo.Abp.Swashbuckle)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.AspNetCore\Snow.AspNetCore.csproj" />
    <ProjectReference Include="..\Snow.AspNetCore.Mvc\Snow.AspNetCore.Mvc.csproj" />
  </ItemGroup>

</Project>
