<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Caching</RootNamespace>
    <Description>分布式缓存: 强类型缓存包装、缓存键规范化、序列化与多键批量读写</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Aop\Snow.Aop.csproj" />
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
  </ItemGroup>

</Project>
