<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Snow.VirtualFileSystem</AssemblyName>
    <PackageId>Snow.VirtualFileSystem</PackageId>
    <Description>虚拟文件系统: 虚拟路径到文件提供器的统一访问(对应 ABP 的 Volo.Abp.VirtualFileSystem)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Composite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
  </ItemGroup>

</Project>
