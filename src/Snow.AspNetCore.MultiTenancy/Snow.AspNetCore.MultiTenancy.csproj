<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>Snow.AspNetCore.MultiTenancy</AssemblyName>
	<PackageId>Snow.AspNetCore.MultiTenancy</PackageId>
	<OutputType>Library</OutputType>
	<IsPackable>true</IsPackable>
	<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
	<!-- 能力包只含模块与扩展方法, 不含静态资源; 关掉 StaticWebAssets 以免 SDK 报 scoped css bundle 缺端点 -->
	<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Description>多租户的 Web 适配层: 请求级租户解析(查询串/路由/请求头/Cookie)与中间件(对应 ABP 的 Volo.Abp.AspNetCore.MultiTenancy)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.MultiTenancy\Snow.MultiTenancy.csproj" />
    <ProjectReference Include="..\Snow.AspNetCore\Snow.AspNetCore.csproj" />
  </ItemGroup>

</Project>
