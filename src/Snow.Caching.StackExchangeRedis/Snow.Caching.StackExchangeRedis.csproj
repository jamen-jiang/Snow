<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Caching.StackExchangeRedis</RootNamespace>
    <Description>分布式缓存 Redis 后端: 按 Redis:Configuration 建连, 并把 IDistributedCache 替换为支持多键批量读写的 Redis 实现</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- 显式引用以对齐版本: 上面那个微软包只依赖 StackExchange.Redis 2.7.x, 而锁包(Snow.DistributedLocking.Redis) 用 3.4.x。
         同一进程只能有一份 StackExchange.Redis, 不在这里对齐就会变成编译期 2.7、运行期 3.4 的错配 -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Caching\Snow.Caching.csproj" />
  </ItemGroup>

</Project>
