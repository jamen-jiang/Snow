<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>JSON 序列化: 公共约定 + 默认的 System.Text.Json 实现(对应 ABP 的 Volo.Abp.Json + Volo.Abp.Json.SystemTextJson 两个包, 这里合成一个); 要 Newtonsoft 行为时另装 Snow.Json.Newtonsoft</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
  </ItemGroup>

</Project>
