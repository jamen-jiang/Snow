<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.Json.Newtonsoft</RootNamespace>
    <Description>JSON 的 Newtonsoft.Json 实现: 需要 JsonProperty/JsonIgnore 老特性、JObject 或自定义 Converter 的宿主用它(对位 ABP 的 Volo.Abp.Json.Newtonsoft)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
    <ProjectReference Include="..\Snow.Json\Snow.Json.csproj" />
  </ItemGroup>

</Project>
