<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Snow.DistributedLocking</RootNamespace>
    <Description>分布式锁(与 ABP 的 Volo.Abp.DistributedLocking 同形): 契约、选项、key 归一化、进程内 KeyedLock 实现与空实现, 以及基于 Medallion 的分布式实现</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DistributedLock.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Snow.Core\Snow.Core.csproj" />
  </ItemGroup>
</Project>
