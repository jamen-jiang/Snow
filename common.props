<Project>
  <!-- 所有可发布项目共用的构建与打包元数据, 由各 csproj 显式 Import(与 ABP 的 common.props 同形)
       版本号只在这里维护: 发版时改 Version 一处, 全仓 28 个包同步 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Authors>Snow</Authors>
    <Company>Snow</Company>
    <Product>Snow Framework</Product>
    <Copyright>Copyright (c) Snow</Copyright>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jamen-jiang/Snow</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jamen-jiang/Snow.git</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>NuGet.md</PackageReadmeFile>
    <PackageTags>snow framework modular dependency-injection aop eventbus messaging caching cqrs ddd</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 把符号文件一并打进 nupkg -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- 单独产出 .snupkg 符号包, 调试时可从 nuget.org 符号服务器拉源码 -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)NuGet.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- 源码链接: 把 PDB 里的文件路径映射成 GitHub 上的 raw 地址, 调试时能直接跳到对应 commit 的行。
       一旦引用任何 Microsoft.SourceLink.* 包, SDK 会关掉自己内置的那套(SuppressImplicitGitSourceLink),
       改由这个包接管: GitHub 决定 URL 形状, 它依赖的 Common 提供 _GenerateSourceLinkFile 目标,
       Build.Tasks.Git 提供 LocateRepository(读 commit 与仓库根)。
       只引 GitHub 一个就够, 与 ABP 一致 —— 但 IncludeAssets 必须带 buildtransitive:
       GitHub 的 nuspec 对两个依赖只 exclude="Build,Analyzers", buildTransitive 资产本会流入;
       若在这里写死 runtime; build; native; contentfiles; analyzers, 两个依赖的 buildTransitive 会被筛掉,
       Common.targets 不被 Import, 于是构建能过、PDB 里一条映射都没有、也不报任何警告(静默失效)。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; buildtransitive; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
