    <ProjectReference Include="..\Snow.Domain\Snow.Domain.csproj" />
    <ProjectReference Include="..\Snow.EventBus\Snow.EventBus.csproj" />
    <ProjectReference Include="..\Snow.Security\Snow.Security.csproj" />
    <ProjectReference Include="..\Snow.Uow\Snow.Uow.csproj" />
