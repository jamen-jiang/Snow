<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\common.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Rongia</AssemblyName>
    <PackageId>Rongia</PackageId>
    <Description>Rongia 名称占位包: 不含任何代码, 只引用 Rongia.Core(与 ABP 的 Volo.Abp 同形)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rongia.Core\Rongia.Core.csproj" />
  </ItemGroup>

</Project>
