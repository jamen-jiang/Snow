<?xml version="1.0" encoding="utf-8"?>
<!--
  本地联调用的源配置(不参与发布):
  1) 先跑 build/pack.ps1 把包打进仓库根的 .nuget-packages 目录
  2) 把本文件复制成消费者项目目录下的 nuget.config
  3) dotnet restore 即可从本地源拉到 Snow 包
-->
<configuration>
  <packageSources>
    <clear />
    <add key="snow-local" value="D:\工作项目\Snow\.nuget-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
