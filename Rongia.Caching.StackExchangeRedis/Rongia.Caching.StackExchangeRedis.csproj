<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)..\common.props" />


  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rongia.Caching.StackExchangeRedis</RootNamespace>
    <Description>分布式缓存 Redis 后端: 按 Redis:IsEnabled / Redis:Configuration 装配, 并把 IDistributedCache 替换为支持多键批量读写的 Redis 实现</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rongia.Caching\Rongia.Caching.csproj" />
  </ItemGroup>

</Project>
