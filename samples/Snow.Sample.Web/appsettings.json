{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning",
      "Elsa": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=snow-sample.db",
    "Hangfire": "snow-hangfire.db"
  },
  "Authentication": {
    "SecretKey": "c2FtcGxlLWRldi1vbmx5LXNlY3JldC1rZXktMzItYnl0ZXMtbWluaW11bS1jaGFuZ2UtbWU=",
    "Issuer": "Snow.Sample",
    "Audience": "Snow.Sample",
    "Expiration": "1.00:00:00"
  },
  "OpenApi": {
    "Enabled": true,
    "Title": "Snow 示例 API",
    "Version": "v1",
    "Description": "Snow 全模块示例宿主",
    "RoutePrefix": "openapi",
    "AddJwtBearerSecurity": true
  },
  "BackgroundJobs": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "MaxJobFetchCount": 100,
    "MaxRetryCount": 5,
    "UseDistributedLock": true
  },
  "Hangfire": {
    "UseInMemoryStorage": false,
    "EnableServer": true,
    "EnableDashboard": true,
    "DashboardPath": "/hangfire",
    "DashboardTitle": "Snow 后台任务"
  },
  "Redis": {
    "Configuration": "127.0.0.1:6379,abortConnect=false"
  },
  "Email": {
    "SmtpHost": "localhost",
    "Port": 1025,
    "DefaultFromAddress": "no-reply@snow.local",
    "DefaultFromDisplayName": "Snow Sample",
    "UseSsl": false
  },
  "Ftp": {
    "FtpHost": "",
    "Port": 21,
    "UserName": "",
    "Password": "",
    "UseSsl": false,
    "EncodingName": "utf-8"
  },
  "HttpClient": {
    "BaseAddress": "",
    "Timeout": "00:00:30",
    "UserAgent": "Snow-Sample/1.0"
  },
  "Json": {
    "WriteIndented": false,
    "IgnoreNullValues": true
  },
  "Localization": {
    "DefaultResourceName": "Default",
    "DefaultCulture": "zh-CN",
    "SupportedCultures": [
      "zh-CN",
      "en"
    ]
  },
  "MultiTenancy": {
    "IsEnabled": false,
    "Tenants": []
  },
  "Mvc": {
    "RootPath": "api/app",
    "WrapResultByDefault": true,
    "AutoModelStateValidation": true
  },
  "ObjectMapping": {
    "Mapster": {
      "Enabled": true,
      "CompileMappings": false,
      "ValidateMappings": false
    }
  },
  "SignalR": {
    "Enabled": true,
    "AutoDiscoverHubs": true,
    "EnableDetailedErrors": false
  },
  "CorrelationId": {
    "HttpHeaderName": "X-Correlation-Id",
    "SetResponseHeader": true
  },
  "Validation": {
    "Enabled": true,
    "ValidateNestedObjects": true,
    "MaxDepth": 4,
    "FluentValidation": {
      "Enabled": true,
      "ScanValidators": true,
      "ValidateDataAnnotations": true
    }
  },
  "ExceptionHandling": {
    "SendExceptionDetailsToClients": false,
    "SendStackTraceToClients": false
  },
  "Workflows": {
    "Elsa": {
      "EnableHttp": true,
      "HttpBasePath": "/workflows",
      "EnableApi": true,
      "RunMigrations": true
    }
  }
}
