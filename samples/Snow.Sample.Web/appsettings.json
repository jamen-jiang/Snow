{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning",
      "Elsa": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=snow-sample.db",
    "Hangfire": "DataBase/snow.db"
  },
  "Authentication": {
    "SecretKey": "c2FtcGxlLWRldi1vbmx5LXNlY3JldC1rZXktMzItYnl0ZXMtbWluaW11bS1jaGFuZ2UtbWU=",
    "Issuer": "Snow.Sample",
    "Audience": "Snow.Sample",
    "Expiration": "1.00:00:00"
  },
  "OpenApi": {
    "Enabled": true,
    "Title": "Snow 示例 API",
    "Version": "v1",
    "Description": "Snow 全模块示例宿主",
    "RoutePrefix": "openapi",
    "AddJwtBearerSecurity": true
  },
  "Redis": {
    "Configuration": "127.0.0.1:6379,abortConnect=false"
  },
  "Settings": {
    "Snow.Mailing.Smtp.Host": "localhost",
    "Snow.Mailing.Smtp.Port": "1025",
    "Snow.Mailing.Smtp.EnableSsl": "false",
    "Snow.Mailing.Smtp.UseDefaultCredentials": "true",
    "Snow.Mailing.DefaultFromAddress": "no-reply@snow.local",
    "Snow.Mailing.DefaultFromDisplayName": "Snow Sample",
    "Snow.Ftp.Host": "127.0.0.1",
    "Snow.Ftp.Port": "21",
    "Snow.Ftp.UserName": "anonymous",
    "Snow.Ftp.UseSsl": "false",
    "Snow.Ftp.EncodingName": "utf-8"
  },
  "HttpClient": {
    "BaseAddress": "",
    "Timeout": "00:00:30",
    "UserAgent": "Snow-Sample/1.0"
  },
  "Json": {
    "WriteIndented": false,
    "IgnoreNullValues": true
  },
  "CorrelationId": {
    "HttpHeaderName": "X-Correlation-Id",
    "SetResponseHeader": true
  },
  "Validation": {
    "Enabled": true,
    "ValidateNestedObjects": true,
    "MaxDepth": 4,
    "FluentValidation": {
      "Enabled": true,
      "ScanValidators": true,
      "ValidateDataAnnotations": true
    }
  }
}