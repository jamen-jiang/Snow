<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Rongia.Messaging</RootNamespace>
    <Description>消息派发实现: 命令总线、查询总线、处理器包装、管道编排与程序集扫描注册; 契约(命令/查询/管道行为接口)位于 Rongia.Core 的 Messaging 目录,命名空间同为 Rongia.Messaging</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rongia.Core/Rongia.Core.csproj" />
  </ItemGroup>
</Project>
